{% macro render_info_panel(panel) %} {# the first panel is the info panel #}
<div markdown="1" class="Panel">
### {{ panel.title }} 
{{ panel.PanelContent }}
</div>
{% endmacro %}

{% macro render_panel(panel) %}
#### {{ panel.title }}
<div markdown="1" class="Panel">
{{ panel.PanelContent}}
</div>
{% endmacro %}


{% macro render_last_panel(panel) %}
#### {{ panel.title }} 
<div markdown="1" class="Panel LastPanel">
{{ panel.PanelContent }}
</div>
{% endmacro %}


{% macro render_entry(entry) %}
<div markdown="1" class="Entry">
{{ render_info_panel(entry.PageContent[0]) }}  {# the first panel is always the info panel #}

{% for panel in entry.PageContent[1:-1]%}
{{ render_panel(panel) }}
{% endfor %}
 {% if entry.PageContent|length > 1 %}
    {{render_last_panel(entry.PageContent[-1])}}  {# the last panel is always the only panel, that is supposed to scroll when needed #}
{% endif %}

</div>
{% endmacro %}


{%macro render_page(page)%}
# {{ page.title }}

{% for entry in page.entries %}
{{ render_entry(entry) }}
{% endfor %}

{% endmacro %}


{{render_page(page)}}