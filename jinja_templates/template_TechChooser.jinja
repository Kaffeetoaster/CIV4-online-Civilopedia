

{% macro render_tech(tech)%}
<div markdown="1" class="TechBox" style="left:{{tech.x}}px;top:{{tech.y}}px;width:{{tech.width}}px;height:{{tech.height}}px;">

{{ tech.TechBoxContent }} {# contains, the tech name, tech icon and tech effects#}

</div>
{% endmacro %}




{%macro render_TechTree(TechTree)%}
# Tech Tree
<div markdown="1" class="TechTree">

{% for tech in TechTree.techs %}
{{ render_tech(tech) }}
{% endfor %}

{{ TechTree.Arrows }} {# contains the arrows between the techs #}

</div>
{% endmacro %}


{{render_TechTree(TechTree)}}