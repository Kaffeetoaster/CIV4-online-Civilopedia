

{% macro render_tech(tech)%}
<div markdown="1" class="Panel TechBox" style="position: absolute; left:{{tech.x}}px; top:{{tech.y}}px; width:{{tech.width}}px; height:{{tech.height}}px;">

{{ tech.TechBoxContent }} {# contains, the tech name, tech icon and tech effects#}

</div>
{% endmacro %}




{%macro render_TechTree(TechTree)%}
# Tech Tree
<div markdown="1" class="Entry TechTree">
<div markdown="1" class="TechTreeCanvas" style="position: relative; width:{{TechTree.width}}px; height:{{TechTree.width}}px;">

{% for arrow in TechTree.arrows %}
{{ arrow }} {# contains the arrows between the techs #}
{% endfor %} 


{% for tech in TechTree.techs %}
{{ render_tech(tech) }}
{% endfor %}



</div>
</div>
{% endmacro %}


{{render_TechTree(TechTree)}}